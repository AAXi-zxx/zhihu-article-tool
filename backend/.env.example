# ========================================
# AI 知乎文章创作工具 - 后端环境变量示例
# 复制本文件为 .env 并填入实际密钥
# ========================================

# 服务器配置
SERVER_PORT=8567
SERVER_HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_passage_creator
DB_USER=root
DB_PASSWORD=123456

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI 文本生成（中科大 LLM 网关，OpenAI 兼容）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://api.llm.ustc.edu.cn/v1
DASHSCOPE_MODEL=qwen-chat

# Pexels 图片搜索（申请 https://www.pexels.com/api/）
PEXELS_API_KEY=your-pexels-api-key

# 腾讯云 COS 图片存储（腾讯云控制台 CAM 取密钥 + 建存储桶）
TENCENT_COS_SECRET_ID=your-cos-secret-id
TENCENT_COS_SECRET_KEY=your-cos-secret-key
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=your-bucket-name
TENCENT_COS_DOMAIN=

# AI 生图（智谱 CogView，OpenAI 兼容接口）
NANO_BANANA_API_KEY=your-zhipu-api-key
NANO_BANANA_BASE_URL=https://open.bigmodel.cn/api/paas/v4
NANO_BANANA_MODEL=cogview-3-flash
NANO_BANANA_ASPECT_RATIO=16:9
NANO_BANANA_IMAGE_SIZE=1024x1024
NANO_BANANA_OUTPUT_MIME_TYPE=image/png

# Iconify 图标
ICONIFY_API_URL=https://api.iconify.design
ICONIFY_SEARCH_LIMIT=10
ICONIFY_DEFAULT_HEIGHT=64
ICONIFY_DEFAULT_COLOR=

# 表情包搜索
EMOJI_PACK_SEARCH_URL=https://cn.bing.com/images/async
EMOJI_PACK_SUFFIX=表情包
EMOJI_PACK_TIMEOUT=10000

# SVG 示意图
SVG_DIAGRAM_DEFAULT_WIDTH=800
SVG_DIAGRAM_DEFAULT_HEIGHT=600
SVG_DIAGRAM_FOLDER=svg-diagrams

# 多智能体并行编排
AGENT_IMAGE_MAX_CONCURRENCY=3
AGENT_IMAGE_FAIL_FAST=true
